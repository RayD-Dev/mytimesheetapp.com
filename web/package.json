{
  "name": "timesheetapp-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:components": "vitest run --passWithNoTests component.test",
    "codegen": "orval",
    "codegen:check": "node src/shared/api/codegen-check.mjs",
    "contract:lint": "redocly lint ../contract/openapi.yaml --config ../contract/redocly.yaml",
    "test:e2e": "playwright test --pass-with-no-tests",
    "audit": "node ../.claude/skills/ui-audit/scripts/slop-scan.mjs --strict src"
  },
  "dependencies": {
    "@nuxt/ui": "4.12.0",
    "pinia": "4.1.0",
    "tailwindcss": "4.3.4",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@redocly/cli": "2.72.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "30.1.3",
    "orval": "8.46.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@parcel/watcher"]
  }
}
