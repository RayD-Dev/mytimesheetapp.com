{
  "name": "timesheetapp-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:components": "vitest run --passWithNoTests component.test",
    "codegen": "node -e \"console.log('codegen: added in task 3')\"",
    "codegen:check": "node -e \"console.log('codegen:check: added in task 3')\"",
    "contract:lint": "npx @redocly/cli lint ../contract/openapi.yaml --config ../contract/redocly.yaml",
    "test:e2e": "playwright test --pass-with-no-tests",
    "audit": "node ../.claude/skills/ui-audit/scripts/slop-scan.mjs --strict src"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@nuxt/ui": "4.12.0",
    "pinia": "4.1.0",
    "tailwindcss": "4.3.4",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ]
  }
}
